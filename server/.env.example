# ---- required in production ----
AUTH_SECRET=change-me-to-a-long-random-string
DATABASE_URL=postgres://user:pass@host/db?sslmode=require   # Neon free; without it data lives in memory (lost on redeploy)
ADMIN_TOKEN=change-me-admin-token                              # Madyan Panel «دفتري» link + Pro activation codes (long random)

# ---- OTP (phone verification) — pick one; until set the app offers Google / offline ----
OTP_PROVIDER=whatsapp_cloud        # whatsapp_cloud | sms | dev | none
WHATSAPP_TOKEN=                    # Meta WhatsApp Cloud API permanent token (Madyan's own number)
WHATSAPP_PHONE_ID=                 # Phone number ID from Meta (not the phone number)
WHATSAPP_TEMPLATE=                 # optional: approved AUTHENTICATION template name (e.g. daftari_code); empty = plain text
WHATSAPP_TEMPLATE_LANG=ar
SMS_PROVIDER_URL=                  # Twilio-style: https://api.twilio.com/2010-04-01/Accounts/<SID>/Messages.json
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM=

# ---- Google sign-in ----
GOOGLE_CLIENT_IDS=                 # accepted Web client IDs, comma-separated (new project first, old after)
GOOGLE_CLIENT_ID=                  # (older single-ID form, still read)

# ---- «مدين» AI (chat + smart import) — key never in the app ----
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GEMINI_API_KEY=                    # fallback
GEMINI_MODEL=gemini-2.0-flash
CHAT_DAILY_LIMIT=60
